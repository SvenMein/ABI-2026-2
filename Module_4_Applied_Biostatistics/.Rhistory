pca_rec_trained <-
pca_rec |>
prep()
pca_rec_trained <-
pca_recipe |>
prep()
pca_preped <- # As intermediated step for data prep
pca_rec_trained |>
step_pca(all_numeric_predictors(), id = "pca_step") |>
prep()
pca_baked <-
pca_preped |>
bake(new_data = rawdata)
pca_baked
pca_baked |>
ggplot(aes(x = .panel_x, y = .panel_y, color = Tissuetype, fill = Tissuetype)) +
geom_point(alpha = 0.4, size = 0.5) +
geom_autodensity(alpha = .5) +
facet_matrix(vars(starts_with("PC")), layer.diag = 2)
pca_loadings <-
pca_preped %>%
tidy(id = "pca_step")
pca_loadings
pca_loadings |>
group_by(component) |>
slice_max(abs(value), n = 10) |>
ungroup() |>
ggplot(aes(
x = abs(value), y = reorder_within(terms, abs(value), component),
fill = value > 0
)) +
geom_col() +
scale_y_reordered() +
facet_wrap(vars(component), scales = "free_y") +
labs(
x = "Absolute value of loading",
y = NULL,
fill = "Positive?",
title = "Principal Component Loadings"
)
pca_loadings |>
filter(component %in% c("PC1", "PC2")) |>
pivot_wider(names_from = component, values_from = value) |>
ggplot(aes(x = PC1, y = PC2)) +
geom_segment(aes(xend = PC1, yend = PC2),
x = 0, y = 0, arrow = arrow(length = unit(0.2, "cm"))
) +
geom_text(aes(label = terms), check_overlap = TRUE, vjust = 1, hjust = 1) +
theme_minimal() +
labs(title = "Variable Loadings Biplot (PC1 vs PC2)")
