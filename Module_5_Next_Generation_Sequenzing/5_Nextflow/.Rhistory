ls
BiocManager::install()
install.packages("BiocManager")
BiocManager::install("DESeq2")
a
### Load the DeSeq2 packages
library(DESeq2)
# Load the CD8 counts
# CD8_counts contains reads mapped to transcripts
setwd("C:/Users/Sven Meinerz/Dropbox/Module 5 - Next Generation Sequenzing/5 - Nextflow")
CD8_counts <- read.csv("../RNA-Seq_Dataset/CD8_counts.csv", row.names = 1, header = T)
sum(rowSums(CD8_counts) == 0) # no reads
hist(rowSums(CD8_counts), breaks=500, xlim = c(0,1000000), main = "Total number of reads per gene")
sampleTable <- data.frame(condition = factor(c(rep("old",8), rep("young",8))),
sex = factor(c("M","F", "F", rep("M",3), rep("F",2),rep("M",3), rep("F",2), "M",rep("F",2))),
batch = factor(c(rep(1,4),rep(2,4),rep(1,4),rep(2,4)))
)
rownames(sampleTable) <- colnames(CD8_counts)
dds <- DESeqDataSetFromMatrix(countData =  CD8_counts,
colData = sampleTable,
design =~ condition ) # design formula defines the factors to be considered while doing DEG analysis
counts(dds) # retrieve read counts from dds
keep <- rowSums(CD8_counts) >= 10
dds.filtered <- dds[keep,]
keep.100 <- rowSums(CD8_counts) >= 100
dds.filtered.100 <- dds[keep.100,]
dds.filtered.100 <- DESeq(dds.filtered.100)
dds.filtered.100.res <- results(dds.filtered.100, contrast = c("condition", "young", "old"), pAdjustMethod = "BH")
head(dds.filtered.100.res)
sum(dds.filtered.100.res$padj <0.05,na.rm=T)
# Extract the differentially expressed genes from results
sigDEGs <- dds.filtered.100.res[which(dds.filtered.100.res$padj<0.05), ]
# Sort the DEG by increasing adjusted p-value and decreasing log2(FC)
sigDEGs.sorted <- sigDEGs[order(sigDEGs$padj, -abs(sigDEGs$log2FoldChange)),]
head(sigDEGs.sorted)
# Export to a csv file
write.csv(sigDEGs.sorted, file = "CD8_young_vs_old_SigDEGs.csv", row.names=T)
write.table(sigDEGs.sorted, file = "CD8_young_vs_old_SigDEGs.csv", row.names=T, col.names=T, sep="\t")
# reads before the normalization
raw_counts <- counts(dds.filtered.100, normalize = F)
# reads after the normalization
norm_counts <- counts(dds.filtered.100, normalize = T)
se <- SummarizedExperiment(log2(norm_counts+1), colData = colData(dds.filtered.100))
plotPCA(DESeqTransform(se))
plotPCA(DESeqTransform(se), ntop=2000) # increase the number of transcripts used for PCA
plotPCA(DESeqTransform(se), intgroup=c("sex"))
plotPCA(DESeqTransform(se), intgroup=c("batch")) # clear signs of batch-effect
plotPCA(DESeqTransform(se), intgroup=c("batch", "condition"))
